<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#FFFFFF"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="John Doe"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#2a5082"/>

        <TextView
            android:id="@+id/tvUserPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="017..."
            android:textSize="12sp"
            android:textColor="#999"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvUserMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My clothes were very clean, thanks!"
        android:textSize="15sp"
        android:layout_marginTop="5dp"
        android:textColor="#333"/>

    <LinearLayout
        android:id="@+id/layoutAdminReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Reply:"
            android:textStyle="bold"
            android:textColor="#d35400"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tvAdminReplyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Glad you liked it!"
            android:textStyle="italic"
            android:textColor="#555"/>
    </LinearLayout>

</LinearLayout>